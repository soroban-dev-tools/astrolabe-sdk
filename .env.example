# @astrolabe/sdk environment configuration example
# Copy this file to .env for local development and integration testing.

# Stellar test account secret key (S...) used for integration tests
# Optional: if omitted, live integration tests in test/integration.test.ts are safely skipped.
STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC URL override
# Defaults to https://soroban-testnet.stellar.org for testnet,
# or http://localhost:8000/soroban/rpc for local network preset.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase override
# Defaults to "Test SDF Network ; September 2015" for testnet,
# or "Standalone Network ; February 2017" for local network preset.
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Constellation / Local Deployment Configuration
# Can be a JSON string or a file path to a JSON file containing deployed contract addresses.
# CONSTELLATION_DEPLOYMENTS={"networkPassphrase":"Standalone Network ; February 2017","contracts":{"schema_registry":"CDAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","attestation":"CBAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}
